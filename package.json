{
	"name": "website",
	"type": "module",
	"version": "0.0.1",
	"engines": {
		"node": ">=22.23.4"
	},
	"scripts": {
		"fetch": "node scripts/fetch-sources.mjs",
		"predev": "node scripts/fetch-sources.mjs --skip-if-exists",
		"dev": "astro dev",
		"prebuild": "node scripts/fetch-sources.mjs",
		"build": "astro build",
		"postbuild": "pagefind --site dist && node scripts/check-links.mjs",
		"check-links": "node scripts/check-links.mjs",
		"test": "node --test test/*.test.mjs",
		"preview": "astro preview",
		"astro": "astro"
	},
	"dependencies": {
		"@astrojs/check": "^0.9.12",
		"@astrojs/markdown-satteri": "^0.4.10",
		"@astrojs/sitemap": "^3.7.6",
		"astro": "^7.4.13",
		"lucide-astro": "^0.556.0",
		"pagefind": "^1.6.0",
		"sass": "^1.98.0",
		"sharp": "^0.35.5",
		"typescript": "^5.9.3"
	}
}

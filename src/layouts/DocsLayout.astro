---
import Base from './Base.astro';
import type { MarkdownHeading } from 'astro';
import { ChevronLeft, ChevronRight, PanelLeft, Pencil } from 'lucide-astro';
import SidebarTree from '../components/SidebarTree.astro';
import { siteMap } from '../lib/site-map.mjs';
import { github } from '../lib/sources.mjs';

interface Props {
	page: {
		title: string;
		description?: string;
		route: string;
		source: string;
		repo: string;
		path: string;
	};
	headings?: MarkdownHeading[];
}

const { page, headings = [] } = Astro.props;
const tab = siteMap().tabs.find((t) => t.source.id === page.source)!;
const root = tab.root!;
const index = tab.pages.findIndex((p) => p.route === page.route);
const prev = index > 0 ? tab.pages[index - 1] : undefined;
const next = index >= 0 && index < tab.pages.length - 1 ? tab.pages[index + 1] : undefined;

const toc = headings.filter((h) => h.depth >= 2 && h.depth <= 3);
const editUrl = `${github}/${page.repo}/edit/main/${page.path}`;
const sourceUrl = `${github}/${page.repo}/blob/main/${page.path}`;
---

<Base title={page.title} description={page.description}>
	<Fragment slot="head">
		<meta name="zane:source" content={`${page.repo}/${page.path}`} />
	</Fragment>
	<div class="docs">
		<button class="docs__menu" type="button" aria-controls="docs-sidebar" aria-expanded="false">
			<PanelLeft size={16} />
			<span>{tab.source.label} contents</span>
		</button>

		<aside id="docs-sidebar" class="docs__sidebar">
			<nav class="tree" aria-label={`${tab.source.label} pages`}>
				<a href={root.route} class:list={['tree__root', { 'tree__root--active': page.route === root.route }]}
					aria-current={page.route === root.route ? 'page' : undefined}>
					{root.title}
				</a>
				<SidebarTree nodes={root.children} current={page.route} />
			</nav>
		</aside>
		<div class="docs__scrim" hidden></div>

		<main class="docs__main">
			<article class="markdown" data-pagefind-body>
				<span hidden data-pagefind-filter="section">{tab.source.label}</span>
				<span hidden data-pagefind-meta="section">{tab.source.label}</span>
				<slot />
			</article>

			<footer class="docs__footer">
				<div class="docs__source">
					<a class="docs__edit" href={editUrl} target="_blank" rel="noopener">
						<Pencil size={14} /> Edit this page on GitHub
					</a>
					<a class="docs__edit" href={sourceUrl} target="_blank" rel="noopener">
						{`zane-lang/${page.repo}`} · <code>{page.path}</code>
					</a>
				</div>
				{(prev || next) && (
					<nav class="pager" aria-label="Previous and next page">
						{prev ? (
							<a class="pager__link" href={prev.route} rel="prev">
								<span class="pager__hint"><ChevronLeft size={14} /> Previous</span>
								<span class="pager__title">{prev.title}</span>
							</a>
						) : <span />}
						{next && (
							<a class="pager__link pager__link--next" href={next.route} rel="next">
								<span class="pager__hint">Next <ChevronRight size={14} /></span>
								<span class="pager__title">{next.title}</span>
							</a>
						)}
					</nav>
				)}
			</footer>
		</main>

		{toc.length > 1 && (
			<aside class="docs__toc">
				<nav aria-label="On this page">
					<p class="toc__heading">On this page</p>
					<ul class="toc">
						{toc.map(h => (
							<li class={`toc__item toc__item--${h.depth}`}>
								<a href={`#${h.slug}`}>{h.text}</a>
							</li>
						))}
					</ul>
				</nav>
			</aside>
		)}
	</div>
</Base>

<script>
	const button = document.querySelector<HTMLButtonElement>('.docs__menu');
	const sidebar = document.getElementById('docs-sidebar');
	const scrim = document.querySelector<HTMLElement>('.docs__scrim');

	const setOpen = (open: boolean) => {
		sidebar?.classList.toggle('docs__sidebar--open', open);
		button?.setAttribute('aria-expanded', String(open));
		if (scrim) scrim.hidden = !open;
	};

	button?.addEventListener('click', () => setOpen(!sidebar?.classList.contains('docs__sidebar--open')));
	scrim?.addEventListener('click', () => setOpen(false));
	document.addEventListener('keydown', e => { if (e.key === 'Escape') setOpen(false); });

	// A language label and a copy button on every code block.
	for (const pre of document.querySelectorAll<HTMLPreElement>('.markdown pre')) {
		const wrapper = document.createElement('div');
		wrapper.className = 'code-block';
		pre.replaceWith(wrapper);
		wrapper.append(pre);
		const tools = document.createElement('div');
		tools.className = 'code-block__tools';
		const lang = pre.dataset.language;
		if (lang && lang !== 'plaintext') {
			const label = document.createElement('span');
			label.className = 'code-block__lang';
			label.textContent = lang;
			tools.append(label);
		}
		const copy = document.createElement('button');
		copy.type = 'button';
		copy.className = 'code-block__copy';
		copy.textContent = 'Copy';
		copy.addEventListener('click', async () => {
			try {
				await navigator.clipboard.writeText(pre.innerText.replace(/\n$/, ''));
				copy.textContent = 'Copied';
			} catch {
				getSelection()?.selectAllChildren(pre);
				copy.textContent = 'Selected';
			}
			setTimeout(() => (copy.textContent = 'Copy'), 1600);
		});
		tools.append(copy);
		wrapper.append(tools);
	}

	// Keep the current page in view in a long sidebar.
	document.querySelector('.docs__sidebar [aria-current="page"]')?.scrollIntoView({ block: 'center' });

	// Highlight the section being read in "On this page".
	const pairs = [...document.querySelectorAll<HTMLAnchorElement>('.toc a')].flatMap(link => {
		try {
			const target = document.getElementById(decodeURIComponent(link.hash.slice(1)));
			return target ? [{ link, target }] : [];
		} catch {
			return []; // malformed percent-encoding
		}
	});
	if (pairs.length) {
		const update = () => {
			const offset = 120;
			let active = pairs[0];
			for (const p of pairs) if (p.target.getBoundingClientRect().top - offset <= 0) active = p;
			for (const p of pairs) p.link.classList.toggle('active', p === active);
		};
		addEventListener('scroll', update, { passive: true });
		update();
	}
</script>

<style lang="scss">
	$sidebar: 260px;
	$toc: 220px;

	.docs {
		width: 100%;
		max-width: 1440px;
		margin: 0 auto;
		flex: 1;
		display: grid;
		grid-template-columns: $sidebar minmax(0, 1fr) $toc;
		grid-template-areas: "sidebar main toc";

		&:not(:has(.docs__toc)) {
			grid-template-columns: $sidebar minmax(0, 1fr);
			grid-template-areas: "sidebar main";
		}
	}

	.docs__menu { display: none; }
	.docs__scrim { display: none; }

	.docs__sidebar {
		grid-area: sidebar;
		position: sticky;
		top: var(--nav-height);
		height: calc(100vh - var(--nav-height));
		overflow-y: auto;
		padding: 2rem 1rem 2rem 1.5rem;
		border-right: 1px solid var(--border);
	}

	.docs__main {
		grid-area: main;
		width: 100%;
		max-width: 800px;
		margin: 0 auto;
		padding: 2.5rem 3rem 4rem;
	}

	.docs__toc {
		grid-area: toc;
		position: sticky;
		top: var(--nav-height);
		align-self: start;
		max-height: calc(100vh - var(--nav-height));
		overflow-y: auto;
		padding: 2.5rem 1.5rem 2rem 0.5rem;
		font-size: 0.85rem;
	}

	// ── Sidebar tree ──────────────────────────────────────────────────────────

	.tree {
		display: flex;
		flex-direction: column;
		font-size: 0.9rem;
	}

	.tree__root {
		display: block;
		padding: 0.4rem 0.6rem;
		margin-bottom: 0.75rem;
		border-radius: var(--radius-sm);
		color: var(--text);
		font-weight: 600;

		&:hover { color: var(--text); background: var(--bg-subtle); }
		&--active { background: var(--tint); color: var(--tint-text); }
		&--active:hover { background: var(--tint); color: var(--tint-text); }
	}

	// ── On this page ──────────────────────────────────────────────────────────

	.toc__heading {
		font-size: 0.75rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--text-faint);
		margin-bottom: 0.75rem;
	}

	.toc {
		list-style: none;
		border-left: 1px solid var(--border);

		a {
			display: block;
			padding: 0.25rem 0 0.25rem 0.9rem;
			margin-left: -1px;
			border-left: 2px solid transparent;
			color: var(--text-muted);
			line-height: 1.4;

			&:hover { color: var(--text); }
			&.active { color: var(--accent); border-left-color: var(--accent); }
		}
	}

	.toc__item--3 a { padding-left: 1.8rem; }

	// ── Page footer ───────────────────────────────────────────────────────────

	.docs__footer {
		margin-top: 4rem;
		padding-top: 1.5rem;
		border-top: 1px solid var(--border);
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
	}

	.docs__source {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 0.5rem 1.5rem;
	}

	.docs__edit {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		align-self: flex-start;
		font-size: 0.85rem;
		color: var(--text-muted);

		&:hover { color: var(--accent); }
		code { font-size: 0.8rem; }
	}

	.pager {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1rem;
	}

	.pager__link {
		display: flex;
		flex-direction: column;
		gap: 0.2rem;
		padding: 0.9rem 1.1rem;
		border: 1px solid var(--border);
		border-radius: var(--radius);
		background: var(--surface);
		transition: border-color 0.15s ease, background 0.15s ease;

		&:hover {
			border-color: var(--accent);
			background: var(--accent-soft);
		}

		&--next {
			text-align: right;
			grid-column: 2;
			.pager__hint { justify-content: flex-end; }
		}
	}

	.pager__hint {
		display: flex;
		align-items: center;
		gap: 0.2rem;
		font-size: 0.8rem;
		color: var(--text-muted);
	}

	.pager__title {
		font-weight: 500;
		color: var(--text);
	}

	// ── Responsive ────────────────────────────────────────────────────────────

	@media (max-width: 1180px) {
		.docs,
		.docs:not(:has(.docs__toc)) {
			grid-template-columns: $sidebar minmax(0, 1fr);
			grid-template-areas: "sidebar main";
		}
		.docs__toc { display: none; }
	}

	@media (max-width: 860px) {
		.docs,
		.docs:not(:has(.docs__toc)) {
			display: block;
		}

		.docs__menu {
			position: sticky;
			top: var(--nav-height);
			z-index: 50;
			display: flex;
			align-items: center;
			gap: 0.5rem;
			width: 100%;
			padding: 0.7rem 1rem;
			border: none;
			border-bottom: 1px solid var(--border);
			background: color-mix(in srgb, var(--bg) 90%, transparent);
			backdrop-filter: blur(12px);
			color: var(--text-muted);
			font-size: 0.875rem;
			cursor: pointer;

			&:hover { color: var(--text); }
		}

		.docs__sidebar {
			position: fixed;
			z-index: 90;
			top: var(--nav-height);
			left: 0;
			bottom: 0;
			height: auto;
			width: min(300px, 85vw);
			background: var(--bg);
			transform: translateX(-100%);
			visibility: hidden;
			transition: transform 0.2s ease, visibility 0.2s;

			&.docs__sidebar--open {
				transform: none;
				visibility: visible;
				box-shadow: 0 0 40px rgb(0 0 0 / 0.25);
			}
		}

		.docs__scrim:not([hidden]) {
			display: block;
			position: fixed;
			z-index: 80;
			inset: var(--nav-height) 0 0 0;
			background: rgb(0 0 0 / 0.4);
		}

		.docs__main { padding: 1.75rem 1rem 3rem; }
		.pager { grid-template-columns: 1fr; }
		.pager__link--next { grid-column: 1; }
	}
</style>

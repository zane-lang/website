---
import Base from './Base.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import type { MarkdownHeading } from 'astro';
import { ChevronLeft, ChevronRight, PanelLeft, Pencil } from 'lucide-astro';
import { site } from '../config.ts';

interface Props {
	doc: CollectionEntry<'docs'>;
	headings?: MarkdownHeading[];
}

const { doc, headings = [] } = Astro.props;
const title = doc.data.title;
const docs = await getCollection('docs');
const current = Astro.url.pathname.replace(/\/$/, '') || '/';
const rootDoc = docs.find(d => d.id === 'docs');

type Segment = 'line' | 'edge' | 'corner' | 'empty';

type FlatNode = {
	title: string;
	href: string;
	structure: Segment[];
};

type TreeNode = {
	title: string;
	href: string;
	children: Record<string, TreeNode>;
};

const tree: Record<string, TreeNode> = {};
for (const d of docs.filter(d => d.id !== 'docs').sort((a, b) => a.id.localeCompare(b.id))) {
	const parts = d.id.replace(/^docs\//, '').split('/');
	let node = tree;
	for (let i = 0; i < parts.length; i++) {
		const part = parts[i];
		if (!node[part]) node[part] = { title: part, href: '', children: {} };
		if (i === parts.length - 1) {
			node[part].title = d.data.title;
			node[part].href = '/docs/' + parts.join('/');
		}
		node = node[part].children;
	}
}

function flatten(nodes: Record<string, TreeNode>, ancestors: ('line' | 'empty')[] = []): FlatNode[] {
	const entries = Object.entries(nodes);
	return entries.flatMap(([, node], i) => {
		const isLast = i === entries.length - 1;
		return [
			{ title: node.title, href: node.href, structure: [...ancestors, isLast ? 'corner' : 'edge'] as Segment[] },
			...flatten(node.children, [...ancestors, isLast ? 'empty' : 'line']),
		];
	});
}

const flat = flatten(tree);

// Reading order for the previous/next links: the overview, then the tree.
const order = [
	...(rootDoc ? [{ title: rootDoc.data.title, href: '/docs' }] : []),
	...flat.filter(n => n.href),
];
const index = order.findIndex(n => n.href === current);
const prev = index > 0 ? order[index - 1] : undefined;
const next = index >= 0 && index < order.length - 1 ? order[index + 1] : undefined;

const toc = headings.filter(h => h.depth >= 2 && h.depth <= 3);

// doc.filePath is relative to the project root, e.g. src/content/docs/docs/cli.md.
const sourcePath = doc.filePath?.replace(/^src\/content\/docs\//, '');
const editUrl = sourcePath ? `${site.docsRepo}/edit/${site.docsBranch}/${sourcePath}` : undefined;
---

<Base title={title} description={doc.data.description}>
	<div class="docs">
		<button class="docs__menu" type="button" aria-controls="docs-sidebar" aria-expanded="false">
			<PanelLeft size={16} />
			<span>Contents</span>
		</button>

		<aside id="docs-sidebar" class="docs__sidebar">
			<nav class="tree" aria-label="Documentation">
				{rootDoc && (
					<a href="/docs" class:list={['tree__root', { 'tree__root--active': current === '/docs' }]}>
						{rootDoc.data.title}
					</a>
				)}
				{flat.map(node => (
					node.href
						? <a href={node.href} title={node.title}
							class:list={['tree__item', { 'tree__item--active': current === node.href }]}
							aria-current={current === node.href ? 'page' : undefined}>
							<span class="tree__path">
								{node.structure.slice(1).map(type => <span class={`path-unit path-unit--${type}`} />)}
							</span>
							<span class="tree__label">{node.title}</span>
						</a>
						: <span class="tree__item tree__item--group">
							<span class="tree__path">
								{node.structure.slice(1).map(type => <span class={`path-unit path-unit--${type}`} />)}
							</span>
							<span class="tree__label">{node.title}</span>
						</span>
				))}
			</nav>
		</aside>
		<div class="docs__scrim" hidden></div>

		<main class="docs__main">
			<article class="markdown">
				<slot />
			</article>

			<footer class="docs__footer">
				{editUrl && (
					<a class="docs__edit" href={editUrl} target="_blank" rel="noopener">
						<Pencil size={14} /> Edit this page on GitHub
					</a>
				)}
				{(prev || next) && (
					<nav class="pager" aria-label="Previous and next page">
						{prev ? (
							<a class="pager__link" href={prev.href} rel="prev">
								<span class="pager__hint"><ChevronLeft size={14} /> Previous</span>
								<span class="pager__title">{prev.title}</span>
							</a>
						) : <span />}
						{next && (
							<a class="pager__link pager__link--next" href={next.href} rel="next">
								<span class="pager__hint">Next <ChevronRight size={14} /></span>
								<span class="pager__title">{next.title}</span>
							</a>
						)}
					</nav>
				)}
			</footer>
		</main>

		{toc.length > 1 && (
			<aside class="docs__toc">
				<nav aria-label="On this page">
					<p class="toc__heading">On this page</p>
					<ul class="toc">
						{toc.map(h => (
							<li class={`toc__item toc__item--${h.depth}`}>
								<a href={`#${h.slug}`}>{h.text}</a>
							</li>
						))}
					</ul>
				</nav>
			</aside>
		)}
	</div>
</Base>

<script>
	const button = document.querySelector<HTMLButtonElement>('.docs__menu');
	const sidebar = document.getElementById('docs-sidebar');
	const scrim = document.querySelector<HTMLElement>('.docs__scrim');

	const setOpen = (open: boolean) => {
		sidebar?.classList.toggle('docs__sidebar--open', open);
		button?.setAttribute('aria-expanded', String(open));
		if (scrim) scrim.hidden = !open;
	};

	button?.addEventListener('click', () => setOpen(!sidebar?.classList.contains('docs__sidebar--open')));
	scrim?.addEventListener('click', () => setOpen(false));
	document.addEventListener('keydown', e => { if (e.key === 'Escape') setOpen(false); });

	// Highlight the section being read in "On this page".
	const links = [...document.querySelectorAll<HTMLAnchorElement>('.toc a')];
	const targets = links
		.map(a => document.getElementById(decodeURIComponent(a.hash.slice(1))))
		.filter((el): el is HTMLElement => !!el);
	if (targets.length) {
		const update = () => {
			const offset = 120;
			let active = targets[0];
			for (const t of targets) if (t.getBoundingClientRect().top - offset <= 0) active = t;
			for (const a of links) a.classList.toggle('active', decodeURIComponent(a.hash.slice(1)) === active.id);
		};
		addEventListener('scroll', update, { passive: true });
		update();
	}
</script>

<style lang="scss">
	$sidebar: 260px;
	$toc: 220px;

	.docs {
		width: 100%;
		max-width: 1440px;
		margin: 0 auto;
		flex: 1;
		display: grid;
		grid-template-columns: $sidebar minmax(0, 1fr) $toc;
		grid-template-areas: "sidebar main toc";

		&:not(:has(.docs__toc)) {
			grid-template-columns: $sidebar minmax(0, 1fr);
			grid-template-areas: "sidebar main";
		}
	}

	.docs__menu { display: none; }
	.docs__scrim { display: none; }

	.docs__sidebar {
		grid-area: sidebar;
		position: sticky;
		top: var(--nav-height);
		height: calc(100vh - var(--nav-height));
		overflow-y: auto;
		padding: 2rem 1rem 2rem 1.5rem;
		border-right: 1px solid var(--border);
	}

	.docs__main {
		grid-area: main;
		width: 100%;
		max-width: 800px;
		margin: 0 auto;
		padding: 2.5rem 3rem 4rem;
	}

	.docs__toc {
		grid-area: toc;
		position: sticky;
		top: var(--nav-height);
		align-self: start;
		max-height: calc(100vh - var(--nav-height));
		overflow-y: auto;
		padding: 2.5rem 1.5rem 2rem 0.5rem;
		font-size: 0.85rem;
	}

	// ── Sidebar tree ──────────────────────────────────────────────────────────

	.tree {
		display: flex;
		flex-direction: column;
		font-size: 0.9rem;
	}

	.tree__root {
		display: block;
		padding: 0.4rem 0.6rem;
		margin-bottom: 0.75rem;
		border-radius: var(--radius-sm);
		color: var(--text);
		font-weight: 600;

		&:hover { color: var(--text); background: var(--bg-subtle); }
		&--active { background: var(--tint); color: var(--tint-text); }
		&--active:hover { background: var(--tint); color: var(--tint-text); }
	}

	.tree__item {
		display: flex;
		align-items: stretch;
		border-radius: var(--radius-sm);
		color: var(--text-muted);
		padding-left: 0.6rem;

		&:hover { color: var(--text); }

		&--group { color: var(--text); font-weight: 500; }

		&--active {
			color: var(--accent);
			font-weight: 500;

			.tree__label { background: var(--accent-soft); }
			&:hover { color: var(--accent); }
		}
	}

	.tree__path {
		display: flex;
		flex-shrink: 0;
	}

	.tree__label {
		display: block;
		padding: 0.3rem 0.5rem;
		border-radius: var(--radius-sm);
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
		min-width: 0;
		flex: 1;
	}

	.path-unit {
		position: relative;
		width: 1rem;
		flex-shrink: 0;

		&--line::before,
		&--edge::before,
		&--corner::before {
			content: '';
			position: absolute;
			left: calc(50% - 0.5px);
			top: 0;
			bottom: 0;
			width: 1px;
			background: var(--border-strong);
		}

		&--corner::before { bottom: 50%; }

		&--edge::after,
		&--corner::after {
			content: '';
			position: absolute;
			left: 50%;
			top: 50%;
			right: 0;
			height: 1px;
			background: var(--border-strong);
		}
	}

	// ── On this page ──────────────────────────────────────────────────────────

	.toc__heading {
		font-size: 0.75rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--text-faint);
		margin-bottom: 0.75rem;
	}

	.toc {
		list-style: none;
		border-left: 1px solid var(--border);

		a {
			display: block;
			padding: 0.25rem 0 0.25rem 0.9rem;
			margin-left: -1px;
			border-left: 2px solid transparent;
			color: var(--text-muted);
			line-height: 1.4;

			&:hover { color: var(--text); }
			&.active { color: var(--accent); border-left-color: var(--accent); }
		}
	}

	.toc__item--3 a { padding-left: 1.8rem; }

	// ── Page footer ───────────────────────────────────────────────────────────

	.docs__footer {
		margin-top: 4rem;
		padding-top: 1.5rem;
		border-top: 1px solid var(--border);
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
	}

	.docs__edit {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		align-self: flex-start;
		font-size: 0.85rem;
		color: var(--text-muted);

		&:hover { color: var(--accent); }
	}

	.pager {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1rem;
	}

	.pager__link {
		display: flex;
		flex-direction: column;
		gap: 0.2rem;
		padding: 0.9rem 1.1rem;
		border: 1px solid var(--border);
		border-radius: var(--radius);
		background: var(--surface);
		transition: border-color 0.15s ease, background 0.15s ease;

		&:hover {
			border-color: var(--accent);
			background: var(--accent-soft);
		}

		&--next {
			text-align: right;
			grid-column: 2;
			.pager__hint { justify-content: flex-end; }
		}
	}

	.pager__hint {
		display: flex;
		align-items: center;
		gap: 0.2rem;
		font-size: 0.8rem;
		color: var(--text-muted);
	}

	.pager__title {
		font-weight: 500;
		color: var(--text);
	}

	// ── Responsive ────────────────────────────────────────────────────────────

	@media (max-width: 1180px) {
		.docs,
		.docs:not(:has(.docs__toc)) {
			grid-template-columns: $sidebar minmax(0, 1fr);
			grid-template-areas: "sidebar main";
		}
		.docs__toc { display: none; }
	}

	@media (max-width: 860px) {
		.docs,
		.docs:not(:has(.docs__toc)) {
			display: block;
		}

		.docs__menu {
			position: sticky;
			top: var(--nav-height);
			z-index: 50;
			display: flex;
			align-items: center;
			gap: 0.5rem;
			width: 100%;
			padding: 0.7rem 1rem;
			border: none;
			border-bottom: 1px solid var(--border);
			background: color-mix(in srgb, var(--bg) 90%, transparent);
			backdrop-filter: blur(12px);
			color: var(--text-muted);
			font-size: 0.875rem;
			cursor: pointer;

			&:hover { color: var(--text); }
		}

		.docs__sidebar {
			position: fixed;
			z-index: 90;
			top: var(--nav-height);
			left: 0;
			bottom: 0;
			height: auto;
			width: min(300px, 85vw);
			background: var(--bg);
			transform: translateX(-100%);
			visibility: hidden;
			transition: transform 0.2s ease, visibility 0.2s;

			&.docs__sidebar--open {
				transform: none;
				visibility: visible;
				box-shadow: 0 0 40px rgb(0 0 0 / 0.25);
			}
		}

		.docs__scrim:not([hidden]) {
			display: block;
			position: fixed;
			z-index: 80;
			inset: var(--nav-height) 0 0 0;
			background: rgb(0 0 0 / 0.4);
		}

		.docs__main { padding: 1.75rem 1rem 3rem; }
		.pager { grid-template-columns: 1fr; }
		.pager__link--next { grid-column: 1; }
	}
</style>

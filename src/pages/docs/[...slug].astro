---
export const prerender = false;

import DocsLayout from '../../layouts/DocsLayout.astro';
import { getNav, renderDoc } from '../../lib/docs';

const slug = Astro.params.slug;

const [nav, doc] = await Promise.all([getNav(), renderDoc(slug)]);

if (!doc) {
	Astro.response.status = 404;
}

// Let the CDN serve the rendered page and revalidate in the background, so
// edits to the docs repo appear within the cache window without a redeploy.
Astro.response.headers.set(
	'Cache-Control',
	'public, s-maxage=300, stale-while-revalidate=600'
);
---

<DocsLayout title={doc?.title ?? 'Not found'} docs={nav} headings={doc?.headings ?? []}>
	{doc ? (
		<div class="markdown" set:html={doc.html} />
	) : (
		<div class="markdown">
			<h1>Page not found</h1>
			<p>There is no doc at this address. Pick one from the sidebar.</p>
		</div>
	)}
</DocsLayout>

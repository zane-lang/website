---
import { Sun, Moon, Github } from 'lucide-astro';
import { site } from '../config.ts';
import Search from './Search.astro';

interface NavLink {
	label: string;
	href: string;
}
interface Props {
	links?: NavLink[];
}
const { links = [] } = Astro.props;
const current = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => current === href || current.startsWith(href + '/');
const isExternal = (href: string) => /^https?:\/\//.test(href);
---

<header class="nav">
	<div class="container nav__inner">
		<a href="/" class="nav__logo" aria-label={`${site.name} home`}>
			<img src={site.logo} alt="" width="26" height="26" />
			<span>{site.name}</span>
		</a>
		<nav class="nav__links" aria-label="Main">
			{links.map((link) => (
				<a
					href={link.href}
					class:list={['nav__link', { 'nav__link--active': isActive(link.href) }]}
					aria-current={isActive(link.href) ? 'page' : undefined}
					{...(isExternal(link.href) ? { target: '_blank', rel: 'noopener' } : {})}
				>
					{link.label}
				</a>
			))}
		</nav>
		<div class="nav__actions">
			<Search />
			<slot name="actions" />
			<a href={site.github} class="nav__icon" aria-label="Zane on GitHub" target="_blank" rel="noopener">
				<Github size={17} />
			</a>
			<button id="theme-toggle" class="nav__icon" type="button" aria-label="Toggle colour theme">
				<Sun size={17} class="icon-sun" />
				<Moon size={17} class="icon-moon" />
			</button>
		</div>
	</div>
</header>

<script>
	const btn = document.getElementById('theme-toggle');
	const html = document.documentElement;

	btn?.addEventListener('click', () => {
		const next = html.dataset.theme === 'dark' ? 'light' : 'dark';
		html.setAttribute('data-theme', next);
		html.setAttribute('data-theme-locked', '');
		try { localStorage.setItem('theme', next); } catch {}
	});
</script>

<style lang="scss">
	.nav {
		position: sticky;
		top: 0;
		z-index: 100;
		background: color-mix(in srgb, var(--bg) 92%, transparent);
		border-bottom: 1px solid var(--border);
		backdrop-filter: saturate(1.4) blur(12px);
		-webkit-backdrop-filter: saturate(1.4) blur(12px);

		// A thin brand stripe along the top edge.
		&::before {
			content: '';
			position: absolute;
			inset: 0 0 auto 0;
			height: 3px;
			background: linear-gradient(90deg, var(--brand-maroon), var(--brand-gold));
		}

		&__inner {
			height: var(--nav-height);
			display: flex;
			align-items: center;
			gap: 1.5rem;
		}

		&__logo {
			display: inline-flex;
			align-items: center;
			gap: 0.6rem;
			font-weight: 650;
			font-size: 1.15rem;
			letter-spacing: -0.02em;
			color: var(--text);
			flex-shrink: 0;

			&:hover { color: var(--text); }
			img { transition: transform 0.2s ease; }
			&:hover img { transform: rotate(-8deg); }
		}

		&__links {
			display: flex;
			gap: 0.25rem;
			min-width: 0;
			overflow-x: auto;
			scrollbar-width: none;
		}

		&__link {
			font-size: 0.9rem;
			color: var(--text-muted);
			padding: 0.35rem 0.7rem;
			border-radius: var(--radius-sm);
			white-space: nowrap;
			transition: color 0.15s ease, background 0.15s ease;

			&:hover { color: var(--text); background: var(--bg-subtle); }
			&--active { color: var(--text); background: var(--surface-2); }
		}

		&__actions {
			display: flex;
			align-items: center;
			gap: 0.4rem;
			margin-left: auto;
		}

		&__icon {
			width: 36px;
			height: 36px;
			display: flex;
			align-items: center;
			justify-content: center;
			background: transparent;
			border: 1px solid var(--border);
			border-radius: var(--radius-sm);
			color: var(--text-muted);
			cursor: pointer;
			transition: color 0.15s ease, border-color 0.15s ease, background 0.15s ease;

			&:hover {
				color: var(--accent);
				border-color: color-mix(in srgb, var(--accent) 50%, var(--border));
				background: var(--accent-soft);
			}
		}

		// On narrow screens, the tabs move to a scrolling strip under the bar,
		// and global.scss increases --nav-height to fit the strip.
		@media (max-width: 900px) {
			&__inner {
				height: auto;
				flex-wrap: wrap;
				gap: 0 0.75rem;
			}
			&__logo, &__actions { height: 60px; }
			&__links {
				order: 3;
				flex-basis: 100%;
				height: 44px;
				align-items: center;
				margin: 0 -0.5rem;
				border-top: 1px solid var(--border);
			}
			&__link { padding: 0.35rem 0.5rem; }
		}

		@media (max-width: 440px) {
			&__link { padding: 0.35rem 0.4rem; font-size: 0.85rem; }
		}
	}

	:global([data-theme="dark"] #theme-toggle .icon-moon),
	:global([data-theme="light"] #theme-toggle .icon-sun) { display: none; }
</style>

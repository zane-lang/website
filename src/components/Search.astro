---
// Full-text search over every tab, from the Pagefind index that `npm run build`
// writes to dist/pagefind. Opens from the button, `/` or Ctrl/Cmd+K.
import { Search } from 'lucide-astro';
---

<button class="search-open" type="button" aria-haspopup="dialog" aria-keyshortcuts="/ Control+K Meta+K">
	<Search size={16} />
	<span class="search-open__label">Search</span>
	<kbd class="search-open__key">/</kbd>
</button>

<dialog class="search" aria-label="Search the documentation">
	<div class="search__panel">
		<div id="search-ui"></div>
		<p class="search__unavailable" hidden>
			Search works on the built site. Run <code>npm run build</code> and <code>npm run preview</code> to try it locally.
		</p>
	</div>
</dialog>

<script>
	const dialog = document.querySelector<HTMLDialogElement>('dialog.search')!;
	const openButton = document.querySelector<HTMLButtonElement>('.search-open')!;
	let loaded: Promise<void> | undefined;

	function load(): Promise<void> {
		loaded ??= new Promise<void>((resolve) => {
			const css = document.createElement('link');
			css.rel = 'stylesheet';
			css.href = '/pagefind/pagefind-ui.css';
			document.head.append(css);
			const script = document.createElement('script');
			script.src = '/pagefind/pagefind-ui.js';
			script.onload = () => {
				// @ts-expect-error PagefindUI is the global the script defines.
				new PagefindUI({
					element: '#search-ui',
					showSubResults: true,
					showImages: false,
					resetStyles: false,
					autofocus: true,
					translations: { placeholder: 'Search Learn, Spec, Stories and more' },
				});
				resolve();
			};
			script.onerror = () => {
				dialog.querySelector<HTMLElement>('.search__unavailable')!.hidden = false;
				resolve();
			};
			document.head.append(script);
		});
		return loaded;
	}

	async function open() {
		if (dialog.open) return;
		dialog.showModal();
		await load();
		dialog.querySelector<HTMLInputElement>('input')?.focus();
	}

	openButton.addEventListener('click', open);
	dialog.addEventListener('click', (e) => { if (e.target === dialog) dialog.close(); });
	document.addEventListener('keydown', (e) => {
		const typing = e.target instanceof HTMLElement && (e.target.isContentEditable || /^(INPUT|TEXTAREA|SELECT)$/.test(e.target.tagName));
		if ((e.key === 'k' && (e.metaKey || e.ctrlKey)) || (e.key === '/' && !typing)) {
			e.preventDefault();
			open();
		}
	});
</script>

<style lang="scss">
	.search-open {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		height: 36px;
		padding: 0 0.6rem 0 0.7rem;
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: var(--radius-sm);
		color: var(--text-muted);
		font: inherit;
		font-size: 0.85rem;
		cursor: pointer;

		&:hover { color: var(--text); border-color: var(--border-strong); }
	}

	.search-open__key {
		font-family: var(--font-mono);
		font-size: 0.7rem;
		padding: 0.05rem 0.35rem;
		border: 1px solid var(--border);
		border-radius: 4px;
		color: var(--text-faint);
	}

	@media (max-width: 700px) {
		.search-open { width: 36px; justify-content: center; padding: 0; }
		.search-open__label, .search-open__key { display: none; }
	}

	.search {
		margin: 10vh auto auto;
		width: min(44rem, calc(100vw - 2rem));
		max-height: 75vh;
		padding: 0;
		border: 1px solid var(--border-strong);
		border-radius: var(--radius-lg);
		background: var(--bg);
		color: var(--text);
		box-shadow: 0 30px 80px -20px rgb(0 0 0 / 0.5);

		&::backdrop { background: rgb(0 0 0 / 0.45); backdrop-filter: blur(2px); }
	}

	.search__panel { padding: 1.25rem; }
	.search__unavailable { font-size: 0.9rem; }

	// Pagefind UI, in the site's palette.
	.search :global(#search-ui) {
		--pagefind-ui-scale: 0.85;
		--pagefind-ui-primary: var(--accent);
		--pagefind-ui-text: var(--text);
		--pagefind-ui-background: var(--surface);
		--pagefind-ui-border: var(--border-strong);
		--pagefind-ui-tag: var(--surface-2);
		--pagefind-ui-border-width: 1px;
		--pagefind-ui-border-radius: 8px;
		--pagefind-ui-font: var(--font-sans);
	}
	.search :global(mark) { background: var(--tint); color: var(--tint-text); padding: 0 0.1em; }
</style>

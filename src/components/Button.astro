---
interface Props {
	variant?: 'primary' | 'secondary' | 'ghost';
	size?: 'sm' | 'md' | 'lg';
	href?: string;
	disabled?: boolean;
	[key: string]: any;
}

const { variant = 'primary', size = 'md', href, disabled = false, ...rest } = Astro.props;
const Tag = href ? 'a' : 'button';
---

<Tag
	class={`btn btn--${variant} btn--${size}`}
	href={href}
	disabled={disabled}
	{...rest}
>
	<slot />
</Tag>

<style lang="scss">
	.btn {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		font-family: inherit;
		font-weight: 500;
		border: 1px solid transparent;
		border-radius: var(--radius-sm);
		justify-content: center;
		line-height: 1.2;
		cursor: pointer;
		text-decoration: none;
		transition: all 0.15s ease;
		white-space: nowrap;

		:global(svg) { flex-shrink: 0; }

		&:disabled {
			opacity: 0.4;
			pointer-events: none;
		}

		// Variants
		&--primary {
			background: var(--accent);
			color: var(--on-accent);
			border-color: var(--accent);

			&:hover { background: var(--accent-hover); border-color: var(--accent-hover); color: var(--on-accent); }
		}

		&--secondary {
			background: var(--accent-soft);
			color: var(--accent);
			border-color: var(--border);

			&:hover { border-color: var(--accent); color: var(--accent); }
		}

		&--ghost {
			background: var(--surface);
			color: var(--text);
			border-color: var(--border-strong);

			&:hover { color: var(--text); background: var(--surface-2); border-color: var(--text-faint); }
		}

		// Sizes
		&--sm { font-size: 0.8rem;  padding: 0.35rem 0.75rem; }
		&--md { font-size: 0.9rem;  padding: 0.55rem 1.1rem;  }
		&--lg { font-size: 1rem;    padding: 0.75rem 1.5rem;  }
	}
</style>
